# OpenAI API key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_REQUEST_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# 可选：仅在调用天气工具时才需要
OPENWEATHER_API_KEY=

# 可选：仅在调用联网搜索工具时才需要
TAVILY_API_KEY=

# LRAG使用的局部嵌入模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 演示站点访问认证（请使用随机生成的强密码）
DEMO_USERNAME=demo
DEMO_PASSWORD=

# 公网演示：只公开前端；后端仍仅允许服务器本机访问
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8081
